# App
APP_PROFILE=network_change
APP_BIND=127.0.0.1
APP_PORT=7000
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
SECURE_COOKIES=false
ODYSSEUS_ADMIN_USER=admin
ODYSSEUS_ADMIN_PASSWORD=CHANGE_ME
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Metadata database (SQLite locally; use Postgres for the internal deployment)
DATABASE_URL=sqlite:///./data/app.db
ODYSSEUS_MULTITENANT_POSTGRES=false
POSTGRES_USER=networkchange
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=networkchange

# Vector search / tool index / RAG
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
LOCAL_EMBEDDING_PATH=/home/vht/longnm7/llm-ai/hf_models/bge-small-en-v1.5

# Object storage
ODYSSEUS_USE_MINIO=false
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=networkchange-docs

# Model providers can also be added from the UI
LLM_HOST=localhost
LLM_HOSTS=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# Optional search/notifications
SEARXNG_INSTANCE=http://searxng:8080
NTFY_BASE_URL=http://ntfy:80

# Container filesystem identity
PUID=1000
PGID=1000
# Optional dedicated Kubernetes sandbox MCP. Never reuse the production kubeconfig.
K8S_SANDBOX_KUBECONFIG=
K8S_SANDBOX_NAMESPACE=network-change-sandbox
K8S_SANDBOX_ENABLE_APPLY=false
KUBECTL_PATH=kubectl
